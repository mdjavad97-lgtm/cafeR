# No directory listing
Options -Indexes

# Never serve dotfiles, SQL dumps, docs, logs or local secrets
<FilesMatch "(^\.|\.(sql|md|env|log|db|sqlite|sqlite3|bak)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # هدایت درخواست‌های API به فایل PHP
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/index.php?request=$1 [QSA,L]
    
    # هدایت سایر مسیرهای برنامه (مثل /log و /admin) به فایل React
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [QSA,L]
</IfModule>
