# ===== Node preview server (development only) =====
# Copy this file to `.env` and fill in the values.
PORT=3000
NODE_ENV=development

# REQUIRED in production. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Only needed if a different origin must call the API.
# Example: https://lilifloraldesign.ir
ALLOWED_ORIGINS=

# Public path the app is mounted on. Use "/" for a root deployment,
# "/Menu/" when the app lives in a subfolder (the current live setup).
VITE_BASE=/Menu/

# NOTE: the production/customer product runs on PHP + MySQL, not this Node server.
# Configure the PHP backend through real host environment variables:
#   DB_HOST=localhost
#   DB_NAME=cafe_digital_menu
#   DB_USER=...
#   DB_PASS=...
#   JWT_SECRET=...
